---
import { getEntry } from 'astro:content';
import '../styles/tokens.css';
import '../styles/base.css';

// Schriftwahl aus dem Redaktionsbereich. Faellt auf Fraunces zurueck,
// solange nichts gesetzt ist.
const FONT_STACKS = {
  'fraunces': "'Fraunces', Georgia, 'Times New Roman', serif",
  'inter-tight': "'Inter Tight', system-ui, -apple-system, 'Segoe UI', sans-serif",
};
const design = await getEntry('design', 'theme');
const fontDisplay = FONT_STACKS[design?.data.fontPairing ?? 'fraunces'] ?? FONT_STACKS.fraunces;

interface Props {
  lang: 'de' | 'en';
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const path = Astro.url.pathname.replace(/^\/(de|en)/, '');
const site = 'https://cos-cam.com';
const canonical = `${site}${Astro.url.pathname}`;
const ogImage = `${site}/images/og-image.jpg`;
const ogLocale = lang === 'de' ? 'de_DE' : 'en_US';
const ogLocaleAlt = lang === 'de' ? 'en_US' : 'de_DE';

// JSON-LD: tells Google "this is Curt O. Schaller, a person"
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Curt O. Schaller',
  givenName: 'Curt',
  additionalName: 'Oswald',
  familyName: 'Schaller',
  jobTitle: lang === 'de'
    ? 'Kameramann, Erfinder und Entwickler von ARRI-Kamerastabilisierungssystemen'
    : 'Cinematographer, inventor, and developer of ARRI camera stabilization systems',
  description,
  url: canonical,
  image: ogImage,
  birthPlace: 'Munich, Germany',
  workLocation: { '@type': 'Place', name: 'Munich, Germany' },
  award: 'Academy Scientific and Engineering Award 2025',
  email: 'mailto:curt@cos-cam.com',
  knowsAbout: ['Camera stabilization', 'Steadicam', 'TRINITY', 'artemis', 'Cinematography'],
  affiliation: { '@type': 'Organization', name: 'ARRI' },
};
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <style is:inline set:html={`:root{--font-display:${fontDisplay}}`}></style>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Favicons */}
    <!-- Reihenfolge zaehlt: Google bevorzugt quadratische Rastergrafiken in
         Vielfachen von 48px. /favicon.ico dient als Rueckfallebene fuer
         Crawler, die nur den Standardpfad abfragen. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    {/* hreflang */}
    <link rel="alternate" hreflang="de" href={`${site}/de${path}`} />
    <link rel="alternate" hreflang="en" href={`${site}/en${path}`} />
    <link rel="alternate" hreflang="x-default" href={`${site}/de${path}`} />

    {/* Fonts */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/fraunces-italic-300-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/dm-mono-normal-400-latin.woff2" crossorigin />

    {/* Open Graph */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Curt O. Schaller mit dem Academy Sci-Tech Award 2025" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Curt O. Schaller" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="profile:first_name" content="Curt" />
    <meta property="profile:last_name" content="Schaller" />

    {/* Twitter / X card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Curt O. Schaller mit dem Academy Sci-Tech Award 2025" />

    {/* Theme + branding */}
    <meta name="theme-color" content="#0a0907" />
    <meta name="color-scheme" content="dark" />
    <meta name="author" content="Curt O. Schaller" />

    {/* Structured data for Google */}
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)}></script>
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/animations.ts';
      import '../scripts/spotlight.ts';
    </script>
  </body>
</html>
