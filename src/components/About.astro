---
import { getEntry } from 'astro:content';
import Section from './Section.astro';
import '../styles/components/about.css';

interface Props { lang: 'de' | 'en' }
const { lang } = Astro.props;
const about = await getEntry('about', lang);
if (!about) throw new Error(`Missing about content for ${lang}`);
const { Content } = await about.render();
const { title, timeline } = about.data;
---
<Section id="about" num="01" label="Vita" title={title}>
  <div class="about__body reveal"><Content /></div>

  <ol class="tl" aria-label="Timeline">
    {timeline.map((t) => (
      <li class:list={['tl__row', t.current && 'tl__row--current']}>
        <div class="tl__year">
          <span class="tl__year-num">{t.year}</span>
          {t.yearSuffix && <span class="tl__year-suffix">{t.yearSuffix}</span>}
        </div>
        <div class="tl__rail" aria-hidden="true">
          <span class="tl__dot" />
          {t.current && (
            <svg class="tl__oscar" viewBox="0 0 28 70" aria-hidden="true">
              {/* Stylized Oscar-trophy silhouette: figure on a tiered pedestal */}
              {/* Head */}
              <ellipse cx="14" cy="9" rx="4" ry="5" fill="currentColor" />
              {/* Body — broad shoulders narrowing to waist */}
              <path d="M9 24 L11 36 L11 46 L17 46 L17 36 L19 24 L18 15 L10 15 Z" fill="currentColor" />
              {/* Sword vertical */}
              <rect x="13" y="14" width="2" height="34" fill="currentColor" />
              {/* Sword crossguard */}
              <rect x="10" y="22" width="8" height="1.6" fill="currentColor" />
              {/* Legs/calves tapering into the pedestal */}
              <path d="M11.5 46 L13 56 L15 56 L16.5 46 Z" fill="currentColor" />
              {/* Pedestal — three Art-Deco tiers */}
              <rect x="6" y="56" width="16" height="4" fill="currentColor" />
              <rect x="4" y="60" width="20" height="4" fill="currentColor" />
              <rect x="6" y="64" width="16" height="4" fill="currentColor" />
            </svg>
          )}
        </div>
        <div class="tl__copy">
          <h3 class="tl__title" set:html={t.title} />
          <p class="tl__body" set:html={t.body} />
        </div>
      </li>
    ))}
  </ol>
</Section>
