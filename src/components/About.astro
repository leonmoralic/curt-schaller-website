---
import { getEntry } from 'astro:content';
import Section from './Section.astro';
import '../styles/components/about.css';

interface Props { lang: 'de' | 'en' }
const { lang } = Astro.props;
const about = await getEntry('about', lang);
if (!about) throw new Error(`Missing about content for ${lang}`);
const { Content } = await about.render();
const { title } = about.data;
// Stationen ohne Titel und ohne Text sind in dieser Sprache noch nicht
// uebersetzt — sie werden ausgelassen, nicht leer dargestellt.
const timeline = about.data.timeline.filter((t) => t.title || t.body);
---
<Section id="about" num="01" label="Vita" title={title}>
  <div class="about__body reveal"><Content /></div>

  <ol class="tl" aria-label="Timeline">
    {timeline.map((t) => (
      <li class:list={['tl__row', t.current && 'tl__row--current']}>
        <div class="tl__year">
          <span class="tl__year-num">{t.year}</span>
          {t.yearSuffix && <span class="tl__year-suffix">{t.yearSuffix}</span>}
        </div>
        <div class="tl__rail" aria-hidden="true">
          <span class="tl__dot" />
          {t.awardIcon && (
            <div class="tl__oscar-wrap" aria-hidden="true">
              {t.awardIcon === 'emmy' ? (
                <svg class="tl__oscar" viewBox="0 0 40 110" xmlns="http://www.w3.org/2000/svg">
                  <defs>
                    <linearGradient id="emmyFill" x1="0" y1="0.2" x2="1" y2="0.8">
                      <stop offset="0%" stop-color="#f5dfa6" />
                      <stop offset="35%" stop-color="#d6b76b" />
                      <stop offset="55%" stop-color="#c8a558" />
                      <stop offset="100%" stop-color="#5e4d2d" />
                    </linearGradient>
                    <linearGradient id="emmyHighlight" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="rgba(255,247,210,0.7)" />
                      <stop offset="100%" stop-color="rgba(255,247,210,0)" />
                    </linearGradient>
                  </defs>

                  {/* Emmy: gefluegelte Figur, die ein Atom emporhaelt. */}
                  <g fill="url(#emmyFill)">
                    {/* Atom, von der Figur getragen */}
                    <circle cx="20" cy="12" r="2.6" />
                    {/* Umlaufbahnen, als Ringe angedeutet */}
                    <g fill="none" stroke="url(#emmyFill)" stroke-width="1.1">
                      <ellipse cx="20" cy="12" rx="8" ry="3.2" />
                      <ellipse cx="20" cy="12" rx="8" ry="3.2" transform="rotate(60 20 12)" />
                      <ellipse cx="20" cy="12" rx="8" ry="3.2" transform="rotate(120 20 12)" />
                    </g>
                    {/* Erhobene Arme */}
                    <path d="M16.4 30 Q14.6 22 17.6 16.4 L19.2 17.4 Q16.8 22.4 18.2 30 Z" />
                    <path d="M23.6 30 Q25.4 22 22.4 16.4 L20.8 17.4 Q23.2 22.4 21.8 30 Z" />
                    {/* Kopf */}
                    <ellipse cx="20" cy="32.5" rx="4.2" ry="5" />
                    {/* Rumpf, zur Taille verjuengt, dann leicht ausgestellt */}
                    <path d="M14.5 42
                             Q15.4 39 17.4 38.2
                             L22.6 38.2
                             Q24.6 39 25.5 42
                             L23.6 56
                             Q22.8 62 23.6 68
                             L23 76
                             L17 76
                             L16.4 68
                             Q17.2 62 16.4 56
                             Z" />
                    {/* Fluegel, weit gespreizt */}
                    <path d="M16 44 Q7 36 2.5 22 Q9 30 14 34 Q13.5 39 16 44 Z" />
                    <path d="M24 44 Q33 36 37.5 22 Q31 30 26 34 Q26.5 39 24 44 Z" />
                    {/* Dreistufiger Sockel, wie bei der Oscar-Statue */}
                    <rect x="8" y="76" width="24" height="6" rx="0.8" />
                    <rect x="5" y="82" width="30" height="7" rx="1" />
                    <rect x="8" y="89" width="24" height="6" rx="0.8" />
                  </g>

                  {/* Weicher Lichtsaum, damit das Metall poliert wirkt */}
                  <ellipse cx="17.6" cy="31" rx="1.6" ry="2.2" fill="url(#emmyHighlight)" opacity="0.7" />
                  <path d="M14 46 Q12.6 60 15.4 74 L17 74 Q14.4 60 15.6 46 Z" fill="url(#emmyHighlight)" opacity="0.35" />
                </svg>
              ) : (
                <svg class="tl__oscar" viewBox="0 0 40 110" xmlns="http://www.w3.org/2000/svg">
                  <defs>
                    <linearGradient id="oscarFill" x1="0" y1="0.2" x2="1" y2="0.8">
                      <stop offset="0%" stop-color="#f5dfa6" />
                      <stop offset="35%" stop-color="#d6b76b" />
                      <stop offset="55%" stop-color="#c8a558" />
                      <stop offset="100%" stop-color="#5e4d2d" />
                    </linearGradient>
                    <linearGradient id="oscarHighlight" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="rgba(255,247,210,0.7)" />
                      <stop offset="100%" stop-color="rgba(255,247,210,0)" />
                    </linearGradient>
                  </defs>

                  <g fill="url(#oscarFill)">
                    {/* Head: rounded, slightly oval */}
                    <ellipse cx="20" cy="11" rx="6" ry="7.5" />
                    {/* Neck */}
                    <rect x="17.5" y="17" width="5" height="3.5" />
                    {/* Torso: broad shoulders narrowing to waist, then slight flare to hips */}
                    <path d="M10 26
                             Q11 22 14 21
                             L26 21
                             Q29 22 30 26
                             L27.5 50
                             Q26 56 27 62
                             L26 76
                             L14 76
                             L13 62
                             Q14 56 12.5 50
                             Z" />
                    {/* Arms crossed at chest (small bumps) */}
                    <path d="M11 32 Q8 38 11 44 L13 44 L13 32 Z" />
                    <path d="M29 32 Q32 38 29 44 L27 44 L27 32 Z" />
                    {/* Sword: vertical blade running down the front */}
                    <rect x="18.7" y="23" width="2.6" height="54" rx="0.4" />
                    {/* Sword crossguard */}
                    <rect x="14.5" y="34" width="11" height="2.3" rx="0.6" />
                    {/* Sword pommel */}
                    <circle cx="20" cy="22.5" r="2" />
                    {/* Three-tiered Art Deco pedestal */}
                    <rect x="8" y="76" width="24" height="6" rx="0.8" />
                    <rect x="5" y="82" width="30" height="7" rx="1" />
                    <rect x="8" y="89" width="24" height="6" rx="0.8" />
                    {/* Subtle base shadow */}
                    <ellipse cx="20" cy="98" rx="16" ry="2.5" opacity="0.4" />
                  </g>

                  {/* Soft top highlight to suggest polished metal */}
                  <ellipse cx="17" cy="10" rx="2.2" ry="3" fill="url(#oscarHighlight)" opacity="0.7" />
                  <rect x="13" y="22" width="2" height="50" fill="url(#oscarHighlight)" opacity="0.35" />
                </svg>
              </div>
              )}
            </div>
          )}
        </div>
        <div class="tl__copy">
          <h3 class="tl__title" set:html={t.title} />
          <p class="tl__body" set:html={t.body} />
        </div>
      </li>
    ))}
  </ol>
</Section>
