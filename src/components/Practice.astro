---
import { getEntry } from 'astro:content';
import Section from './Section.astro';
import '../styles/components/practice.css';

interface Props { lang: 'de' | 'en' }
const { lang } = Astro.props;
const p = await getEntry('practice', lang);
if (!p) throw new Error(`Missing practice content for ${lang}`);
const { entries, email } = p.data;
const label = lang === 'de' ? 'Heute' : 'Today';
---
<Section id="practice" num="04" label={label} alt>
  <ol class="practice__list">
    {entries.map((e, i) => (
      <li class="practice__item reveal">
        <a
          class="practice__link"
          href={`mailto:${email}?subject=${encodeURIComponent(e.mailSubject)}`}
          aria-label={`${e.titleItalic} ${e.titleRest} — ${e.mailSubject}`}
        >
          <span class="practice__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="practice__entry-title">
            <em>{e.titleItalic}</em>{' '}{e.titleRest}
          </h3>
          <p class="practice__entry-body">{e.body}</p>
          <span class="practice__entry-tag">{e.tag}</span>
          <span class="practice__arrow" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ol>
</Section>
