{
  "lang": "de",
  "title": "Erfindungen & <em>Entwicklung.</em>",
  "entries": [
    {
      "name": "artemis",
      "year": 2001,
      "principle": "Bei Sachtler entwickelt — das weltweit erste modular aufgebaute Kamerastabilisierungssystem. Vorgestellt auf der NAB Show in Las Vegas. Ein Baukasten-Konzept, das Operator unterschiedliche Kamerakonfigurationen aus einem gemeinsamen System zusammenstellen lässt.",
      "patents": []
    },
    {
      "name": "TRINITY",
      "year": 2015,
      "principle": "Gemeinsam mit Dr. Roman Foltyn entwickelt. Erstes Hybrid-System, das mechanische Steadicam-Stabilisierung und elektronische Gimbal-Stabilisierung in einem einzigen Rig vereint. Ermöglicht stufenlos Bewegungen aus jeder Kameraposition — vom Boden bis über Kopf — ohne Setupwechsel.",
      "patents": []
    },
    {
      "name": "TRINITY 2",
      "year": 2022,
      "principle": "Nachfolger-Generation bei ARRI. Reduziertes Gewicht, erweiterte Stabilisierungs-Modi, überarbeitete Bedienlogik. Konzept, Design und Entwicklung von Curt O. Schaller.",
      "patents": [],
      "award": "Academy Scientific and Engineering Award 2025"
    }
  ],
