{
  "title": "Erfindungen & <em>Entwicklung.</em>",
  "entries": [
    {
      "name": "artemis",
      "year": 2001,
      "principle": "Bei Sachtler entwickelt — das weltweit erste modular aufgebaute Kamera-Stabilisierungs-System für HD-Kameras. Vorgestellt auf der NAB Show in Las Vegas 2001. Ein Baukasten-Konzept, das Operator unterschiedliche Kamerakonfigurationen aus einem gemeinsamen System zusammenstellen lässt.\nEinsatz: \nWeltweit im professionellen Einsatz bei Steadicam-Operatoren. \nBis heute Referenz für modulare Kamerastabilisierung.",
      "patents": [],
      "award": ""
    },
    {
      "name": "TRINITY",
      "year": 2015,
      "principle": "Ab Ende 2014 mit Unterstützung von Dr. Roman Foltyn entwickelt. Erstes Hybrid-System, das mechanische Steadicam-Stabilisierung und elektronische Gimbal-Stabilisierung in einem einzigen Rig vereint. Ermöglicht das TRINITY-System stufenlos Bewegungen aus jeder Kameraposition — vom Boden bis über Kopf — ohne Setupwechsel.\nEinsatz: \nEtabliert als neuer Produktionsstandard bei internationalen Film-, Serien-, Live-und Werbeproduktionen.",
      "patents": [],
      "award": ""
    },
    {
      "name": "TRINITY 2",
      "year": 2022,
      "principle": "Nachfolger-Generation des TRINITY 1. Voll digital, reduziertes Gewicht, erweiterte Stabilisierungs-Modi, überarbeitete Bedienlogik. Konzept, Design und Entwicklung von Curt O. Schaller.",
      "patents": [],
      "award": "Academy Scientific and Engineering Award 2025 - Emmy 2026"
    }
  ],
  "patentBlock": {
