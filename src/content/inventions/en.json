{
  "lang": "en",
  "title": "Inventions & <em>development.</em>",
  "entries": [
    {
      "name": "artemis",
      "year": 2001,
      "principle": "Developed at Sachtler — the world's first modular camera stabilization system. Premiered at the NAB Show in Las Vegas. A kit-based architecture that lets operators assemble different camera configurations from a single shared system.",
      "patents": []
    },
    {
      "name": "TRINITY",
      "year": 2015,
      "principle": "Developed together with Dr. Roman Foltyn. The first hybrid rig to combine mechanical Steadicam stabilization and electronic gimbal stabilization in a single device. Enables continuous camera movement from any position — floor to overhead — without setup changes.",
      "patents": []
    },
    {
      "name": "TRINITY 2",
      "year": 2022,
      "principle": "Next-generation successor at ARRI. Reduced weight, expanded stabilization modes, refined operating logic. Concept, design, and development by Curt O. Schaller.",
      "patents": [],
      "award": "Academy Scientific and Engineering Award 2025"
    }
  ],
